# Skopiuj do deploy/.env (plik jest ignorowany przez git i nie trafia do obrazu).
# Domena wskazująca na serwer (rekord DNS A/AAAA), np. ev-kb.example.com
EV_KB_DOMAIN=
# Token: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
EV_KB_TOKEN=
# Wersja wiedzy pokazywana w instrukcjach serwera: git rev-parse --short=12 HEAD
EV_KB_VERSION=
