{
  "skill": "ev-ocpi-roaming-expert",
  "scenarios": [
    {
      "id": "start-session-bez-sesji",
      "expect": "trigger",
      "prompt": "Jako eMSP wysłaliśmy przez OCPI komendę START_SESSION. CPO odpowiedział ACCEPTED, potem przyszedł CommandResult ACCEPTED, ale żadna sesja się nie pojawiła i klient nie ładuje. Jak to możliwe i jak powinniśmy to obsłużyć w aplikacji? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "CommandResponse"
          ],
          [
            "CommandResult"
          ],
          [
            "asynchron\\w*|response_url"
          ],
          [
            "timeout"
          ],
          [
            "(nie|podłącz)[^.\\n]{0,60}(kabel|kabl|EV|pojazd)|plugged|time-?out[^.\\n]{0,60}(sesj|EV)"
          ],
          [
            "Sessions?|PENDING|ACTIVE"
          ]
        ],
        "none": [
          "CommandResult ACCEPTED (zawsze )?oznacza,? że sesja (się )?rozpoczęła"
        ]
      }
    },
    {
      "id": "credentials-401",
      "expect": "trigger",
      "prompt": "Podłączamy nowego partnera po OCPI 2.2.1. Dostaliśmy od niego mailem token i adres versions. Pobranie /versions działa, ale GET na jego Locations zwraca 401. Co robimy źle? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "CREDENTIALS_TOKEN_A|token(em)? A\\b"
          ],
          [
            "CREDENTIALS_TOKEN_[BC]|token(y|em)? [BC]\\b"
          ],
          [
            "POST[^.\\n]{0,60}credentials|credentials[^.\\n]{0,60}POST"
          ],
          [
            "Base64"
          ],
          [
            "Authorization: Token|nagłów\\w* Authorization"
          ]
        ],
        "none": [
          "token A (można|wolno) używać (do|dla) wszystkich modułów"
        ]
      }
    },
    {
      "id": "sync-po-awarii",
      "expect": "trigger",
      "prompt": "Po kilkugodzinnej awarii połączenia OCPI z hubem: czy powinniśmy zbuforować nieudane PUT i PATCH z aktualizacjami statusów EVSE i wysłać je ponownie? Jak odbiorca ma wrócić do zgodnego stanu, także dla CDR? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "nie (należy |powinn\\w* )?(kolejkow|buforow)|SHOULD NOT be queued|nie kolejkuje"
          ],
          [
            "\\bGET\\b"
          ],
          [
            "date_from"
          ],
          [
            "CDR"
          ],
          [
            "Locations?"
          ],
          [
            "paginac\\w*|offset|X-Total-Count|Link"
          ]
        ],
        "none": [
          "(należy|trzeba) (zbuforować|zakolejkować) (nieudane )?(PUT|PATCH)"
        ]
      }
    },
    {
      "id": "oicp-rfid-autoryzacja",
      "expect": "trigger",
      "prompt": "Podłączamy CPMS do Hubject przez OICP 2.3. Kierowca przykłada kartę RFID, której nasz system nie zna. Jak przebiega autoryzacja i jak powiązać późniejszy CDR z tą sesją? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "eRoamingAuthorizeStart"
          ],
          [
            "SessionID"
          ],
          [
            "broadcast|wszystki\\w* EMP|do wszystkich"
          ],
          [
            "eRoamingChargeDetailRecord|CDR"
          ]
        ],
        "none": [
          "OICP (nie ma|nie obsługuje) autoryzacji RFID"
        ]
      }
    },
    {
      "id": "oicp-vs-ocpi-status",
      "expect": "trigger",
      "prompt": "Mamy integrację OCPI 2.3.0 i dokładamy Hubject (OICP 2.3). Jak zmapować statusy EVSE i czym różni się sposób przesyłania statusów w OICP od OCPI? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "Available|AVAILABLE"
          ],
          [
            "OutOfService|OUTOFORDER|INOPERATIVE"
          ],
          [
            "eRoamingPushEvseStatus|PushEvseStatus"
          ],
          [
            "PullEvseStatus|pull"
          ]
        ],
        "none": [
          "OICP (używa|ma) (tych samych|identycznych) status\\w*"
        ]
      }
    },
    {
      "id": "ochp-cdr-odrzucony",
      "expect": "trigger",
      "prompt": "Partner przez clearing house OCHP 1.4 odrzucił nasz CDR. Jakie mamy opcje jako operator i jakie statusy przejdzie ten CDR? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "declined"
          ],
          [
            "revised"
          ],
          [
            "rejected"
          ],
          [
            "AddCDRs|CheckCDRs"
          ]
        ],
        "none": [
          "credit CDR (jest|to) (jedyn|wymagan)"
        ]
      }
    },
    {
      "id": "patch-sesji-ponowiony",
      "expect": "trigger",
      "prompt": "Jako CPO na OCPI 2.3.0 wysyłamy PATCH sesji z nowymi charging_periods. Po timeoucie ponawiamy ten sam PATCH. Co się może stać i jak to robić poprawnie? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "dopis\\w*|dodaj\\w*|append|add"
          ],
          [
            "\\bPUT\\b"
          ],
          [
            "last_updated"
          ],
          [
            "\\bGET\\b"
          ]
        ],
        "none": [
          "PATCH[^.\\n]{0,40}zastępuje (całą|cała) (listę|lista)"
        ]
      }
    },
    {
      "id": "broadcast-push-cdr-przez-hub",
      "expect": "trigger",
      "prompt": "Jako CPO wysyłamy przez hub OCPI 2.3.0 Broadcast Push z CDR do wszystkich eMSP, a GET lokalizacji partnera robimy też jako Broadcast. Czy to zgodne ze specyfikacją? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "Broadcast Push"
          ],
          [
            "(nie|SHALL NOT)[^.\\n]{0,60}(CDR|Sessions|sesj)|tylko[^.\\n]{0,40}(Tokens|Locations|wspóln)"
          ],
          [
            "Open Routing"
          ],
          [
            "4\\.1\\.9"
          ]
        ],
        "none": []
      }
    },
    {
      "id": "rotacja-tokenu-credentials",
      "expect": "trigger",
      "prompt": "OCPI 2.3.0: jak zmienić (zrotować) token credentials po rejestracji i co zwróci partner, gdy ponownie wyślemy POST na credentials? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "\\bPUT\\b"
          ],
          [
            "405"
          ],
          [
            "miesi\\w*|month"
          ],
          [
            "7\\.1\\.4|7\\.2"
          ]
        ],
        "none": []
      }
    },
    {
      "id": "oicp-kod-017-i-soap",
      "expect": "trigger",
      "prompt": "Hubject zwraca nam w OICP kod 017 na każde żądanie, a do Dynamic Pricing w OICP 2.2 chcieliśmy użyć SOAP. Co jest nie tak? Odpowiedz zwięźle.",
      "checks": {
        "all": [
          [
            "017"
          ],
          [
            "certyfikat\\w*|certificate|Unauthorized"
          ],
          [
            "REST"
          ],
          [
            "2\\.2|2\\.3"
          ]
        ],
        "none": []
      }
    },
    {
   "id": "session-patch-ponowienie-credit-cdr",
   "expect": "trigger",
   "prompt": "Jako CPO wysyłam sesję przez OCPI 2.2.1 PATCH-em z nowymi charging_periods, a po timeoucie ponawiam to samo żądanie. Co się stanie u eMSP i jak poprawnie poprawić CDR, który już wysłałem z błędną kwotą?",
   "checks": {
    "all": [
     ["dopis\\w*|dodaj\\w*|dodan\\w*|append\\w*|dołącz\\w*|drugi raz|zdublow\\w*|podwój\\w*"],
     ["PUT"],
     ["[Cc]redit CDR|credit_reference_id"],
     ["ujemn\\w*|negative|minus"]
    ],
    "none": []
   }
  },
  {
      "id": "ocpp-callerror",
      "expect": "no-trigger",
      "neighbor": "ev-ocpp-expert",
      "prompt": "Ładowarka na OCPP 1.6J odpowiada CALLERROR FormationViolation na nasze ChangeConfiguration. Co oznacza ten kod i czym różni się od statusu Rejected?"
    }
  ]
}
