  {
   "id": "remote-start-accepted-bez-sesji",
   "expect": "trigger",
   "prompt": "Ładowarka na OCPP 1.6J odpowiedziała Accepted na RemoteStartTransaction, ale po dwóch minutach nadal nie ma StartTransaction i sesja nie ruszyła. Co to znaczy i jak CSMS ma to obsłużyć? Odpowiedz zwięźle.",
   "checks": {
    "all": [
     [
      "ConnectionTimeOut"
     ],
     [
      "Accepted[^.\\n]{0,80}(nie oznacza|nie znaczy|≠|to nie)|przyj\\w* (polecenia|żądania)[^.\\n]{0,40}nie"
     ],
     [
      "StatusNotification|TriggerMessage"
     ],
     [
      "(nie|bez)[^.\\n]{0,40}(ponaw|powtarza|retry)|podwójn\\w*|duplikat\\w*|drug\\w* (sesj|transakcj)"
     ],
     [
      "kabel|wtyczk|podłącz|Preparing"
     ]
    ],
    "none": [
     "(od razu|natychmiast) (ponów|wyślij ponownie|powtórz) RemoteStartTransaction"
    ]
   }
  },
